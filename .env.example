# B-SGLEM Deployment & Local Runtime Configuration Template
# Copy to .env for local overrides (never commit secrets to version control)

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Directory Paths (defaults to workspace folders if left empty)
MODEL_DIR=
DATA_DIR=
OUTPUT_DIR=

# Telemetry & Data Pipeline Configuration
ACTIVE_DATASET=2024
DATA_SOURCE_MODE=historical
ENABLE_SIMULATION_MODE=false

# CORS Configuration (comma-separated origins or * for wildcard)
CORS_ORIGINS=http://localhost:8501

# Dashboard API Target URL (used by Streamlit client)
BSGLEM_API_URL=http://127.0.0.1:8000
